cc_library_headers {
    name: "marble_sensor_notifier_headers",
    export_include_dirs: ["include"],
    vendor: true,
}

cc_binary {
    name: "sensor-notifier",
    vendor: true,
    cpp_std: "gnu++20",

    init_rc: ["sensor-notifier.rc"],

    srcs: [
        "main.cpp",
        "notifiers/NonUiNotifier.cpp",
        "notifiers/RawLightNotifier.cpp",
        "SensorNotifier.cpp",
        "udals/CwbClient.cpp",
        "udals/UDalsBleedCompensator.cpp",
        "utils/SensorNotifierUtils.cpp",
        "utils/SscCalApiWrapper.cpp",
    ],

    shared_libs: [
        "android.frameworks.sensorservice@1.0",
        "android.hardware.common-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "libjsoncpp",
        "libnativewindow",
        "libutils",
        "vendor.qti.hardware.display.config-V7-ndk",
    ],

    static_libs: ["libaidlcommonsupport"],

    header_libs: [
        "generated_kernel_headers",
        "marble_sensor_notifier_headers",
    ],
}
